# Supabase (project: szamlafolyo / jdwyqpsvpvzfhjgnzfsx, eu-central-1)
NEXT_PUBLIC_SUPABASE_URL=https://jdwyqpsvpvzfhjgnzfsx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Supabase dashboard → Project Settings → API keys.
SUPABASE_SERVICE_ROLE_KEY=

# AI extraction via OpenRouter (https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=
# Any OpenRouter slug with PDF/image input + tool calling. Default:
# anthropic/claude-sonnet-4.5 — check openrouter.ai/anthropic for newer slugs.
# EXTRACTION_MODEL=anthropic/claude-sonnet-4.5
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Vercel cron authentication (Vercel sets the Authorization header from this)
CRON_SECRET=

# Inbound e-mail (Resend). The MX records point iktato.szamlafolyo.hu at Resend;
# the webhook secret is shown when the webhook is created in the Resend dashboard.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# EMAIL_INBOX_DOMAIN=iktato.szamlafolyo.hu
