APP_NAME=SzámlaFolyó
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://szamlafolyo.hu
APP_LOCALE=hu
APP_FALLBACK_LOCALE=hu
APP_FAKER_LOCALE=hu_HU
APP_TIMEZONE=UTC
# A felületen minden idő Europe/Budapest szerint jelenik meg (App\Support\Ido).

# Amíg az oldal fejlesztés alatt áll: nincs nyilvános regisztráció, és a
# belépés előtti képernyőkön figyelmeztetés fogadja a látogatót. Induláskor
# mindkettőt át kell billenteni. A kollégák meghívása nem ezen múlik — azt a
# tulajdonos a Beállítások képernyőn intézi.
REGISZTRACIO_NYITVA=false
FEJLESZTES_ALATT=true
KAPCSOLAT_EMAIL=info@szamlafolyo.hu

LOG_CHANNEL=daily
LOG_LEVEL=warning

# --- Adatbázis (nethely) -----------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=szamlafolyo
DB_USERNAME=szamlafolyo
DB_PASSWORD=

# Osztott tárhelyen nincs Redis és nincs worker: minden az adatbázisban.
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync

# --- Kimenő levél (nethely SMTP) --------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mail.nethely.hu
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=smtps
MAIL_FROM_ADDRESS=noreply@szamlafolyo.hu
MAIL_FROM_NAME="${APP_NAME}"

# --- AI kiolvasás (OpenRouter) ----------------------------------------------
# Kulcs: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Két valódi számlán mérve ez ugyanazt olvasta ki, mint a Claude Sonnet 5,
# 15× olcsóbban. Váltás előtt érdemes összemérni őket ugyanazon a bizonylaton:
#   artisan kiolvasas:proba ~/szamla.pdf --modell="anthropic/claude-sonnet-5"
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Egy kiolvasásra szánt maximális idő másodpercben (a PHP időkorlát alatt kell maradnia).
OPENROUTER_TIMEOUT=90

# --- Beérkeztető postafiók (nethely IMAP, catch-all) ------------------------
# Minden cég a saját tokenjével kap címet: <token>@INBOX_DOMAIN
INBOX_DOMAIN=bekuldes.szamlafolyo.hu
# Ha a szolgáltató nem ad catch-all fiókot, plusz-címzésre váltunk:
# INBOX_MODE=plus  és INBOX_PLUS_ADDRESS=bekuldes@szamlafolyo.hu
INBOX_MODE=catchall
INBOX_PLUS_ADDRESS=
IMAP_HOST=mail.nethely.hu
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_PROCESSED_FOLDER=Feldolgozott
# Ide kerül a levél, ha a címzettből nem jött ki érvényes cég-token. Külön
# mappa, mert a feldolgozottak közé keverve pont az veszne el, amit keresni kell.
IMAP_UNMATCHED_FOLDER=Besorolatlan
# Megőrzési idő a fiókban (nap, 0 = ne töröljön). A levélben a számla teljes
# másolata ott marad a mellékletben, ezért enélkül betelik a tárhely, és a
# fájlok törlése sem ér semmit. A `fajl:selejtez` végzi, naponta egyszer.
INBOX_KEEP_DAYS=7
# A besorolatlanból nem lett irat: ez az egyetlen példány, és ránézést kér.
INBOX_UNMATCHED_KEEP_DAYS=14

# --- Stripe ------------------------------------------------------------------
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# A csomagok árazonosítói (config/szamlafolyo.php köti őket a darabkerethez).
#
# FONTOS: ami itt hiányzik, az nem „korlátlan", hanem ismeretlen csomag — a
# Kvota ilyenkor a legkisebb csomag keretét adja, és warningot naplóz. A
# Stripe-ban létrehozott árat tehát mindig ide is be kell írni.
#
# Havi. Éves ár szándékosan nincs: a keret a Stripe számlázási ciklusára szól,
# egy éves előfizetésnél tehát évi 50 dokumentum lenne az 50/hó helyett.
STRIPE_PRICE_KICSI=
STRIPE_PRICE_KOZEPES=
STRIPE_PRICE_NAGY=
# A keret fölötti darabár. Csak akkor lép életbe, ha a cég a Beállításokban
# külön engedélyezte a túlhasználatot — enélkül a keret megállít. Egyszeri
# („one time") árként hozd létre őket, ne ismétlődőként: a `tulhasznalat:elszamol`
# darabszámmal tesz fel belőlük tételt a következő számlára.
STRIPE_PRICE_KICSI_EXTRA=
STRIPE_PRICE_KOZEPES_EXTRA=
STRIPE_PRICE_NAGY_EXTRA=
