# Védőháló hibás docroot-beállítás ellen. NEM a normál működés része.
#
# Az alkalmazást a `public/` mappán keresztül kell kiszolgálni. Ha a webcím
# gyökérkönyvtára helyesen oda mutat, az Apache ezt a fájlt el sem olvassa: a
# .htaccess-eket a docroottól lefelé keresi, fölfelé nem.
#
# Ha viszont a docroot tévedésből a projekt gyökerén áll, e nélkül a fájl
# nélkül a `.env` (adatbázis-jelszó, OpenRouter-kulcs, APP_KEY), a `storage/`
# naplói és a teljes forráskód letölthető lenne. Így helyette 403 jön — a
# hangos hiba mindig jobb, mint a csendes szivárgás.

<IfModule mod_authz_core.c>
    # Apache 2.4+
    Require all denied
</IfModule>

<IfModule !mod_authz_core.c>
    # Apache 2.2
    Order allow,deny
    Deny from all
</IfModule>
